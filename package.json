{
  "name": "lume-screen",
  "productName": "Lume",
  "version": "1.0.0",
  "description": "Compartilhamento de tela para Windows, com WebRTC e áudio individual.",
  "main": "electron/main.cjs",
  "private": true,
  "author": "Lume",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/cli.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/browser.e2e.cjs",
    "build:win": "electron-builder --win portable --x64",
    "build:win:zip": "electron-builder --win zip --x64"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "node-turn": "0.0.6",
    "playwright": "1.64.0"
  },
  "build": {
    "appId": "app.lume.screen",
    "productName": "Lume",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "server/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "Lume-${version}-Windows-x64.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
